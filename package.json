{
  "name": "scotty-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Windows desktop wrapper for bead-me-up-scotty",
  "license": "MIT",
  "author": "Steven Liang",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "upstream:fetch": "node scripts/fetch-upstream.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:main": "node scripts/build-main.mjs",
    "dev": "npm run build:main && electron .",
    "dev:attach": "electron . --attach",
    "dist": "npm run build:main && electron-builder",
    "release": "npm run build:main && electron-builder --publish always",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build:server && node scripts/verify-server.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "electron": "43.3.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}